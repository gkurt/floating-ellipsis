{
  "name": "floating-ellipsis",
  "version": "0.1.0",
  "private": true,
  "description": "Fluid, balanced ellipsis: smart text truncation for one or many lines, with the ellipsis anywhere and optically even spacing.",
  "homepage": "https://gkurt.com/floating-ellipsis/",
  "bugs": {
    "url": "https://github.com/gkurt/floating-ellipsis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/floating-ellipsis.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "source": "./src/index.ts"
    },
    "./transitions": {
      "import": {
        "types": "./dist/transitions.d.ts",
        "default": "./dist/transitions.js"
      },
      "source": "./src/transitions.ts"
    },
    "./tooltip": {
      "import": {
        "types": "./dist/tooltip.d.ts",
        "default": "./dist/tooltip.js"
      },
      "source": "./src/tooltip.ts"
    },
    "./text": {
      "import": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "source": "./src/text.ts"
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "source": "./src/element.ts"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "source": "./src/react.ts"
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "source": "./src/vue.ts"
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "source": "./src/svelte.ts"
    }
  },
  "scripts": {
    "dev": "vite demo --port 4181 --strictPort",
    "build": "tsdown",
    "build:site": "vite build demo --base ./ --outDir ../out/site --emptyOutDir",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test",
    "test:browser": "vitest run",
    "checks": "bun check && bun typecheck && bun run test",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
