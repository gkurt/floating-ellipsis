{
  "name": "floating-ellipsis",
  "version": "0.0.0",
  "description": "Fluid, balanced ellipsis: smart text truncation for one or many lines, with the ellipsis anywhere and optically even spacing.",
  "keywords": [
    "ellipsis",
    "line-clamp",
    "middle-ellipsis",
    "react",
    "svelte",
    "text-overflow",
    "tooltip",
    "truncate",
    "truncation",
    "vue",
    "web-component"
  ],
  "homepage": "https://gkurt.com/floating-ellipsis/",
  "bugs": {
    "url": "https://github.com/gkurt/floating-ellipsis/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Gokhan Kurt",
    "email": "krtgkn@gmail.com",
    "url": "https://gkurt.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gkurt/floating-ellipsis.git"
  },
  "workspaces": [
    "examples/*"
  ],
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "imports": {
    "#*": "./*"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "source": "./src/index.ts"
    },
    "./geometry": {
      "import": {
        "types": "./dist/geometry.d.ts",
        "default": "./dist/geometry.js"
      },
      "source": "./src/geometry.ts"
    },
    "./glyphs": {
      "import": {
        "types": "./dist/glyphs.d.ts",
        "default": "./dist/glyphs.js"
      },
      "source": "./src/glyphs.ts"
    },
    "./changes": {
      "import": {
        "types": "./dist/changes.d.ts",
        "default": "./dist/changes.js"
      },
      "source": "./src/changes.ts"
    },
    "./suffix": {
      "import": {
        "types": "./dist/suffix.d.ts",
        "default": "./dist/suffix.js"
      },
      "source": "./src/suffix.ts"
    },
    "./transitions": {
      "import": {
        "types": "./dist/transitions.d.ts",
        "default": "./dist/transitions.js"
      },
      "source": "./src/transitions.ts"
    },
    "./tooltip": {
      "import": {
        "types": "./dist/tooltip.d.ts",
        "default": "./dist/tooltip.js"
      },
      "source": "./src/tooltip.ts"
    },
    "./text": {
      "import": {
        "types": "./dist/text.d.ts",
        "default": "./dist/text.js"
      },
      "source": "./src/text.ts"
    },
    "./element": {
      "import": {
        "types": "./dist/element.d.ts",
        "default": "./dist/element.js"
      },
      "source": "./src/element.ts"
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "source": "./src/react.ts"
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "source": "./src/vue.ts"
    },
    "./svelte": {
      "import": {
        "types": "./dist/svelte.d.ts",
        "default": "./dist/svelte.js"
      },
      "source": "./src/svelte.ts"
    },
    "./fallback.css": "./dist/fallback.css"
  },
  "scripts": {
    "dev": "vite demo --port 4181 --strictPort",
    "build": "tsdown",
    "build:site": "vite build demo --base ./ --outDir ../out/site --emptyOutDir",
    "video": "node scripts/video.ts",
    "typecheck": "tsc",
    "lint": "oxlint",
    "format": "oxfmt",
    "check": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "test": "bun test",
    "test:browser": "vitest run",
    "test:next": "bun run build && bun run --cwd examples/next test",
    "bench": "vitest run --mode bench --silent=false",
    "checks": "bun check && bun typecheck && bun run test",
    "size": "bun scripts/size.ts",
    "tegami": "bun scripts/tegami.mts",
    "prepublishOnly": "bun run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "5.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "playwright": "1.64.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tegami": "^1.5.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.4",
    "vue": "^3.5.44"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "lint-staged": {
    "*": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ]
  }
}
